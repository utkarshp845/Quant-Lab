# Copy this file to backend/.env and fill in real values locally.
# backend/.env is gitignored -- never commit real credentials.
#
# This app does not auto-load .env files (no python-dotenv dependency,
# see app/config.py's docstring for why) -- export these as real
# environment variables in your shell, or use `env $(cat .env | xargs)`
# / your editor's run-config env support to load them.

# Which MarketDataProvider backs any endpoint that doesn't explicitly
# request one (see app/providers/registry.py::get_default_provider).
# One of: csv | alpaca | massive | schwab
# The CSV upload endpoint (/api/csv-import) always uses "csv"
# regardless of this setting -- there's nothing to "configure" about
# uploading a file.
MARKET_DATA_PROVIDER=csv

# --- Alpaca (https://alpaca.markets) ---
# Free to generate on a paper or live account. Powers real equity data
# (get_historical_data / get_latest_quote, v0.1.4) -- options-chain data
# (get_chain) is still a placeholder. Defaults to the free "iex" feed;
# pass feed="sip" explicitly if you're on the paid Algo Trader Plus plan.
# See README section 13 for what's confirmed free vs. paid, and
# backend/scripts/alpaca_manual_check.py to sanity-check these values
# against your real account (TSLA/NVDA bars + quotes).
# These same two values also authenticate the real-time streaming
# connection (v0.1.12, app/streaming/alpaca_stream.py) that backs
# GET /api/market-data/stream -- nothing extra to configure for that.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Massive (https://massive.com -- the Polygon.io rebrand) ---
# A single API key, sent as an "Authorization: Bearer <key>" header.
# Powers real equity data (get_historical_data / get_latest_quote,
# v0.1.6) -- options-chain data (get_chain) is still a placeholder.
# See README section 13, and backend/scripts/massive_manual_check.py
# to sanity-check this value against your real account (TSLA/NVDA
# bars + quotes).
MASSIVE_API_KEY=

# --- Schwab (https://developer.schwab.com) ---
# OAuth2, not a static key -- requires a registered + approved Schwab
# developer app first. Powers real equity data (get_historical_data /
# get_latest_quote, v0.1.8) -- options-chain data (get_chain) is still
# a placeholder. SCHWAB_REDIRECT_URI must match your registered app's
# callback URI exactly (Schwab requires HTTPS, even for a personal app).
# SCHWAB_REFRESH_TOKEN has no self-serve equivalent to "generate a key"
# -- run backend/scripts/schwab_oauth_bootstrap.py once (an interactive
# login only you can do) to get one; it expires after ~7 days and needs
# re-running. See README section 13 for the full explanation, including
# which response field names are confirmed vs. best-effort for this
# provider specifically.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=
SCHWAB_REFRESH_TOKEN=

# --- Historical-bar storage (v0.1.17, app/storage/) ---
# Path to the SQLite database file that persists fetched historical
# bars. Optional -- defaults to backend/data/historical_bars.db
# (created automatically on first save/read) if unset. The file itself
# is gitignored (backend/data/); only this path is configurable here.
DATABASE_PATH=

# --- Auto-ingestion (v0.1.18, app/ingestion/auto_ingest.py) ---
# Unattended, scheduled pulling of historical bars, instead of a human
# clicking "Save to Database" after every manual fetch -- OFF unless
# you explicitly turn it on. Requires real credentials for whichever
# provider AUTO_INGEST_PROVIDER names (see the Alpaca/Massive/Schwab
# sections above) -- this makes real, scheduled outbound API calls for
# AS LONG AS THE APP PROCESS IS RUNNING, including every `uvicorn
# --reload` restart while you're coding. Recommended: enable this only
# in the .env a persistent/long-running server actually loads, and
# leave it false in a throwaway checkout or worktree you use for quick
# manual testing -- there's no separate "dev vs. prod" switch here
# beyond that, so treat this .env file itself as the switch.
#
# Set to "true" to enable; anything else (including unset) is disabled.
AUTO_INGEST_ENABLED=false
# Comma-separated symbols to poll. Defaults to "TSLA,NVDA" if unset.
AUTO_INGEST_SYMBOLS=TSLA,NVDA
# Comma-separated timeframes to poll per symbol (see
# app/api/historical_data.py's ALLOWED_TIMEFRAMES for the vocabulary:
# 1m, 5m, 15m, 1h, 1d). Defaults to "1d" if unset -- if you've backfilled
# intraday history too (scripts/backfill_historical_data.py --timeframes
# 5m), include it here as well (e.g. "1d,5m") or that intraday data goes
# stale the moment you stop manually re-running the backfill script;
# auto-ingest only keeps current whichever timeframes are actually
# listed here.
AUTO_INGEST_TIMEFRAMES=1d
# Which provider to pull from. Defaults to MARKET_DATA_PROVIDER above
# if unset -- only set this separately if you want the unattended loop
# pulling from a different provider than manual fetches use.
AUTO_INGEST_PROVIDER=
# How often (seconds) each configured symbol/timeframe pair is
# re-polled. Defaults to 300 (5 minutes) if unset. TSLA,NVDA x 1d,5m
# every 5 minutes is nowhere near Alpaca's free-tier rate limit (200
# req/min) -- re-check this if you add many more symbols/timeframes or
# a lower-limit provider.
AUTO_INGEST_INTERVAL_SECONDS=300
# How many trailing days each cycle re-fetches (re-fetching an
# overlapping window is deliberate -- see
# app/ingestion/auto_ingest.py's run_ingestion_cycle() docstring for
# why). Defaults to 5 if unset -- the same value applies to every
# configured timeframe, so this also bounds how many 5m bars get
# re-fetched every cycle (5 days x ~78 5m bars/session is still a
# single Alpaca page).
AUTO_INGEST_LOOKBACK_DAYS=5
# How many consecutive FAILED cycles the same symbol/timeframe pair
# needs before app/ingestion/auto_ingest.py's PairFailureTracker
# escalates its log line from WARNING to ERROR (v0.1.23) -- a
# transient blip (rate limit, network hiccup) stays at WARNING; a
# credential that's actually gone stale (an expired Schwab refresh
# token nobody re-ran, a revoked key) keeps failing cycle after cycle
# and escalates instead of blending into routine noise forever.
# Defaults to 3 consecutive cycles (~15 minutes at the default
# interval) if unset.
AUTO_INGEST_FAILURE_ALERT_THRESHOLD=3

# --- Historical backfill (v0.1.22, app/ingestion/backfill.py) ---
# Not a config knob -- run once (or re-run any time; already-saved bars
# are a no-op) to pull a deep, wide date range instead of waiting for
# AUTO_INGEST_LOOKBACK_DAYS's small trailing window to accumulate it
# bar by bar. Needs the same provider credentials as above; nothing
# extra to configure here.
#     export ALPACA_API_KEY_ID=...
#     export ALPACA_API_SECRET_KEY=...
#     ./venv/bin/python scripts/backfill_historical_data.py --provider alpaca
# See that script's own --help / docstring for every flag
# (--symbols/--timeframes/--years/--start/--end/--chunk-days/...).
