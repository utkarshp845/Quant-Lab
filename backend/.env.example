# Copy this file to backend/.env and fill in real values locally.
# backend/.env is gitignored -- never commit real credentials.
#
# This app does not auto-load .env files (no python-dotenv dependency,
# see app/config.py's docstring for why) -- export these as real
# environment variables in your shell, or use `env $(cat .env | xargs)`
# / your editor's run-config env support to load them.

# Which MarketDataProvider backs any endpoint that doesn't explicitly
# request one (see app/providers/registry.py::get_default_provider).
# One of: csv | alpaca | massive | schwab
# The CSV upload endpoint (/api/csv-import) always uses "csv"
# regardless of this setting -- there's nothing to "configure" about
# uploading a file.
MARKET_DATA_PROVIDER=csv

# --- Alpaca (https://alpaca.markets) ---
# Free to generate on a paper or live account. Powers real equity data
# (get_historical_data / get_latest_quote, v0.1.4) -- options-chain data
# (get_chain) is still a placeholder. Defaults to the free "iex" feed;
# pass feed="sip" explicitly if you're on the paid Algo Trader Plus plan.
# See README section 13 for what's confirmed free vs. paid, and
# backend/scripts/alpaca_manual_check.py to sanity-check these values
# against your real account (TSLA/NVDA bars + quotes).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Massive ---
# Auth scheme not yet confirmed against a real account -- see
# massive_provider.py's docstring.
MASSIVE_API_KEY=

# --- Schwab (https://developer.schwab.com) ---
# OAuth2 client credentials -- a real integration will also need a
# stored refresh token, not modeled by this placeholder yet.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
